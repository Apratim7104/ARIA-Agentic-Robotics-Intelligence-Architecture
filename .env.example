# ARIA Environment Configuration Example
# Copy this file to .env and configure your local or cloud endpoints

# Siemens / OpenAI API (Optional - system gracefully falls back to deterministic rule routing when offline)
SIEMENS_LLM_API_KEY=your_api_key_here
SIEMENS_LLM_BASE_URL=https://your-api-endpoint/v1
SIEMENS_LLM_MODEL=qwen-3.6-27b

# Tavily Web Search API (Optional)
TAVILY_API_KEY=your_tavily_key_here

# Hardware & Perception Configuration
CAM_WIDTH=640
CAM_HEIGHT=480
MUJOCO_CAM_NAME=overhead_cam
KMP_DUPLICATE_LIB_OK=TRUE
LOG_LEVEL=INFO
