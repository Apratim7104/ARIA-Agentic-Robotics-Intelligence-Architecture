# Siemens LLM API (OpenAI-compatible)
SIEMENS_LLM_API_KEY=your_siemens_llm_api_key_here
SIEMENS_LLM_BASE_URL=https://your-siemens-llm-endpoint/v1
SIEMENS_LLM_MODEL=qwen-3.6-27b

# Web Search
TAVILY_API_KEY=your_tavily_api_key_here

# Local Vision Model (Qwen2.5-VL)
VISION_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct
VISION_N_FRAMES=6
VISION_MAX_TOKENS=2000
VISION_BOX_QUERY_MAX_TOKENS=512

# Robot Perception
YOLO_MODEL=yolov8n.pt
YOLO_CONF=0.35
SAM2_CONFIG=sam2_hiera_small.yaml
SAM2_CHECKPOINT=checkpoints/sam2_hiera_small.pt

# Camera / Depth
CAM_WIDTH=640
CAM_HEIGHT=480
CAM_FOVY=60.0
DEPTH_NEAR=0.01
DEPTH_FAR=2.50
DEPTH_SCALE=2.50
MUJOCO_CAM_NAME=overhead_cam

# Logging
LOG_LEVEL=INFO
